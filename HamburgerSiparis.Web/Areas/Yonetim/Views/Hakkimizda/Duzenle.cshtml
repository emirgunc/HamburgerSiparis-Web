@model HamburgerSiparis.EntityLayer.Hakkimizda

@{
    ViewBag.Title = "Hakkımızda Yazısını Düzenle";
    Layout = "~/Areas/Yonetim/Views/Shared/_YonetimLayout.cshtml";
}

<h2 class="mt-3">Hakkımızda Yazısını Güncelle</h2>
<hr />


@using (Html.BeginForm("Duzenle", "Hakkimizda", FormMethod.Post))
{
    
    @Html.HiddenFor(m => m.HakkimizdaId)

    <div class="form-group mt-3">
        <label class="fw-bold">Başlık</label>
        @Html.TextBoxFor(m => m.Baslik, new { @class = "form-control", placeholder = "Örn: Kalitenin Tek Adresi" })
    </div>

    <div class="form-group mt-3">
        <label class="fw-bold">İçerik (Dükkanın Hikayesi)</label>
        @Html.TextAreaFor(m => m.Icerik, new { @class = "form-control", rows = "6", placeholder = "Dükkanın kuruluş hikayesi, etlerin kalitesi vs..." })
    </div>

    <button type="submit" class="btn btn-success mt-4">Değişiklikleri Kaydet</button>
    <a href="/Yonetim/Hakkimizda/Index" class="btn btn-secondary mt-4">İptal ve Geri Dön</a>
}