@{
    Layout = null; // Sol menüyü (Sidebar) iptal eder, sayfayı tertemiz yapar!
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Admin Giriş - Burger House</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #121212;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-box {
            background-color: #1e1e1e;
            padding: 40px;
            border-radius: 12px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0px 0px 20px rgba(255, 152, 0, 0.3);
            border: 1px solid #ff9800;
        }

            .login-box h2 {
                color: #ff9800;
                font-weight: bold;
                text-align: center;
                margin-bottom: 5px;
            }

            .login-box p {
                text-align: center;
                color: #aaa;
                margin-bottom: 30px;
            }

        .form-control {
            margin-bottom: 20px;
        }

        .btn-turuncu {
            background-color: #ff9800;
            color: #121212;
            font-weight: bold;
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: 5px;
        }

            .btn-turuncu:hover {
                background-color: #e68a00;
            }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 15px;
            color: #aaa;
            text-decoration: none;
            font-size: 14px;
        }

            .back-link:hover {
                color: #ff9800;
            }
    </style>
</head>
<body>

    <div class="login-box">
        <h2>ADMİN PANELİ</h2>
        <p>Yönetim Paneline Giriş Yapın</p>

        <form action="/Yonetim/Login/Index" method="post">

            <label class="form-label">E-Posta</label>
            <input type="email" name="Email" class="form-control" placeholder="emir@golyakaburger.com" required>

            <label class="form-label">Parola</label>
            <input type="password" name="Sifre" class="form-control" placeholder="******" required>

            <button type="submit" class="btn btn-turuncu">Giriş Yap</button>

            <a href="/Home/Index" class="back-link">← Dükkana Geri Dön</a>
        </form>
    </div>

</body>
</html>