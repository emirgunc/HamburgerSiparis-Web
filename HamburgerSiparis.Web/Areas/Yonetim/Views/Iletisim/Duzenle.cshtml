@model HamburgerSiparis.EntityLayer.Iletisim

@{
    ViewBag.Title = "İletişim Düzenle";
    Layout = "~/Areas/Yonetim/Views/Shared/_YonetimLayout.cshtml";
}

<h2 class="mt-3">İletişim Bilgisini Güncelle</h2>
<hr />

@using (Html.BeginForm("Duzenle", "Iletisim", FormMethod.Post))
{
   
    @Html.HiddenFor(m => m.IletisimId)

    <div class="form-group mt-3">
        <label class="fw-bold">Adres</label>
        @Html.TextAreaFor(m => m.Adres, new { @class = "form-control", rows = "3" })
    </div>

    <div class="form-group mt-3">
        <label class="fw-bold">Telefon Numarası</label>
        @Html.TextBoxFor(m => m.Telefon, new { @class = "form-control" })
    </div>

    <div class="form-group mt-3">
        <label class="fw-bold">E-Mail Adresi</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
    </div>

    <button type="submit" class="btn btn-warning mt-4">Değişiklikleri Kaydet</button>
    <a href="/Yonetim/Iletisim/Index" class="btn btn-secondary mt-4">İptal</a>
}