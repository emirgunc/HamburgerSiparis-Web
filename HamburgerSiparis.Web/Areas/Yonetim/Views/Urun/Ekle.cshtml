@model HamburgerSiparis.EntityLayer.Urun

@{
    ViewBag.Title = "Yeni Ürün Ekle";
    Layout = "~/Areas/Yonetim/Views/Shared/_YonetimLayout.cshtml";
}

<div class="admin-kart shadow-lg mt-4 border-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid #2a2a2a;">
        <h4 class="mb-0 text-white font-weight-bold">Yeni <span class="text-warning">Efsane</span> Ekle</h4>
        <a href="/Yonetim/Urun/Index" class="btn btn-outline-light px-4 py-2" style="border-radius: 8px;">Vazgeç ve Dön</a>
    </div>

    <div class="card-body px-0">
        @using (Html.BeginForm("Ekle", "Urun", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group row mb-4">
                <label class="col-md-2 col-form-label text-light font-weight-bold">Ürün Adı</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.UrunAdi, new { htmlAttributes = new { @class = "form-control bg-dark text-white border-secondary", @style = "border-radius:8px;", placeholder = "Örn: Double Texas Burger" } })
                </div>
            </div>

            <div class="form-group row mb-4">
                <label class="col-md-2 col-form-label text-light font-weight-bold">Kategori</label>
                <div class="col-md-10">
                    @Html.DropDownList("KategoriId", null, "Kategori Seçin", htmlAttributes: new { @class = "form-control bg-dark text-white border-secondary", @style = "border-radius:8px;", required = "required" })
                </div>
            </div>

            <div class="form-group row mb-4">
                <label class="col-md-2 col-form-label text-light font-weight-bold">Fiyat (₺)</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Fiyat, new { htmlAttributes = new { @class = "form-control bg-dark text-white border-secondary", @style = "border-radius:8px;", placeholder = "Örn: 250,00" } })
                </div>
            </div>

           

            <div class="form-group row mb-4">
                <label class="col-md-2 col-form-label text-light font-weight-bold">Ürün Resmi</label>
                <div class="col-md-10">
                    <input type="file" name="UrunResmi" class="form-control-file text-warning mt-2" accept="image/*" required />
                    <small class="text-muted">Masaüstünden burgerin en efsane fotoğrafını seç (JPG/PNG).</small>
                </div>
            </div>

            <div class="form-group row mb-4">
                <label class="col-md-2 col-form-label text-light font-weight-bold">Açıklama</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Aciklama, new { htmlAttributes = new { @class = "form-control bg-dark text-white border-secondary", @style = "border-radius:8px;", placeholder = "Ürün detayları..." } })
                </div>
            </div>

            <div class="form-group row mt-4 pt-4" style="border-top: 1px solid #2a2a2a;">
                <div class="col-md-10 offset-md-2">
                    <button type="submit" class="btn btn-turuncu px-5 py-2 font-weight-bold" style="border-radius: 8px;">Menüye Ekle</button>
                </div>
            </div>
        }
    </div>
</div>