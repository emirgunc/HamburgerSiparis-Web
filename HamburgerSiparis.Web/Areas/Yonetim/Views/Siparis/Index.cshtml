@model IEnumerable<HamburgerSiparis.EntityLayer.Siparis>

@{
    ViewBag.Title = "Gelen Siparişler";
    Layout = "~/Areas/Yonetim/Views/Shared/_YonetimLayout.cshtml";
}

<div class="admin-kart shadow-lg mt-4 border-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid #2a2a2a;">
        <h4 class="mb-0 text-white font-weight-bold">🔔 Gelen <span class="text-warning">Siparişler</span></h4>
    </div>

    <div class="table-responsive">
        <table class="table table-borderless align-middle mb-0">
            <thead>
                <tr style="border-bottom: 2px solid #2a2a2a;">
                    <th class="text-muted pb-3" style="font-weight: 500;">No</th>
                    <th class="text-muted pb-3" style="font-weight: 500;">Tarih</th>
                    <th class="text-muted pb-3" style="font-weight: 500;">Sipariş Detayı</th>
                    <th class="text-muted pb-3" style="font-weight: 500;">Tutar</th>
                    <th class="text-muted pb-3" style="font-weight: 500;">Durum</th>
                    <th class="text-right text-muted pb-3" style="font-weight: 500;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="border-bottom: 1px solid #2a2a2a; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#222'" onmouseout="this.style.backgroundColor='transparent'">
                        <td class="py-3 align-middle text-secondary font-weight-bold">#@item.SiparisId</td>
                        <td class="py-3 align-middle text-light">@item.SiparisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="py-3 align-middle text-info">
                            @string.Join(", ", item.SiparisDetaylari.Select(x => x.Adet + "x " + (x.Urun != null ? x.Urun.UrunAdi : "Ürün Silinmiş")))
                        </td>
                        <td class="py-3 align-middle font-weight-bold" style="color: #ff6600;">@item.ToplamTutar.ToString("N2") ₺</td>
                        <td class="py-3 align-middle">
                            @if (item.Durum == "Hazırlanıyor")
                            {
                                <span class="badge" style="background-color: #ffc107; color: #000; padding: 6px 10px; font-weight:bold;">@item.Durum</span>
                            }
                            else if (item.Durum == "İptal Edildi")
                            {
                                <span class="badge" style="background-color: #dc3545; color: #fff; padding: 6px 10px; font-weight:bold;">@item.Durum</span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: #28a745; color: #fff; padding: 6px 10px; font-weight:bold;">@item.Durum</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.Durum != "Teslim Edildi" && item.Durum != "İptal Edildi")
                            {
                                <a href="@Url.Action("Tamamla", "Siparis", new { id = item.SiparisId })" class="btn btn-success btn-sm fw-bold text-white mb-1">
                                    <i class="fa fa-check"></i> Tamamla
                                </a>
                                <a href="@Url.Action("Iptal", "Siparis", new { id = item.SiparisId })" class="btn btn-danger btn-sm fw-bold text-white">
                                    <i class="fa fa-times"></i> İptal Et
                                </a>
                            }
                            else
                            {
                                <b style="color: #666; font-size: 1.2rem;">-</b>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>