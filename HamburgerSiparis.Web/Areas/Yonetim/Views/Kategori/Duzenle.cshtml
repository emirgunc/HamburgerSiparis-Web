@model HamburgerSiparis.EntityLayer.Kategori

@{
    ViewBag.Title = "Kategori Düzenle";
    Layout = "~/Areas/Yonetim/Views/Shared/_YonetimLayout.cshtml";
}

<div class="admin-kart shadow-lg mt-4 border-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid #2a2a2a;">
        <h4 class="mb-0 text-white font-weight-bold">Kategori Düzenle: <span class="text-warning">@Model.KategoriAdi</span></h4>
        <a href="/Yonetim/Kategori/Index" class="btn btn-outline-light px-4 py-2" style="border-radius: 8px;">Vazgeç ve Dön</a>
    </div>

    <div class="card-body px-0">
        @using (Html.BeginForm("Duzenle", "Kategori", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(model => model.KategoriId)

            <div class="form-group row mb-4">
                <label class="col-md-2 col-form-label text-light font-weight-bold">Kategori Adı</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.KategoriAdi, new { htmlAttributes = new { @class = "form-control bg-dark text-white border-secondary", @style = "border-radius:8px;" } })
                    @Html.ValidationMessageFor(model => model.KategoriAdi, "", new { @class = "text-danger mt-1 d-block" })
                </div>
            </div>

            <div class="form-group row mt-4 pt-4" style="border-top: 1px solid #2a2a2a;">
                <div class="col-md-10 offset-md-2">
                    <button type="submit" class="btn btn-turuncu px-5 py-2 font-weight-bold" style="border-radius: 8px;">Değişiklikleri Kaydet</button>
                </div>
            </div>
        }
    </div>
</div>