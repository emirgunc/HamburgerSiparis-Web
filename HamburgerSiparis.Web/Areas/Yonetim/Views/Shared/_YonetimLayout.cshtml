<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetim Paneli - BURGER HOUSE</title>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">


    <style>
        body {
            background-color: #121212;
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
        }

        .sidebar {
            background-color: #1a1a1a;
            border-right: 1px solid #2a2a2a;
            min-height: 100vh;
            padding-top: 20px;
        }

        .sidebar-brand {
            color: #ff6600;
            font-weight: 700;
            font-size: 1.2rem;
            text-align: center;
            padding: 20px;
            border-bottom: 1px solid #2a2a2a;
            margin-bottom: 20px;
        }

        .nav-link {
            color: #aaaaaa !important;
            padding: 12px 25px;
            font-weight: 500;
            transition: 0.3s;
        }

            .nav-link:hover, .nav-link.active {
                background-color: #222;
                color: #ff6600 !important;
                border-left: 4px solid #ff6600;
            }

        .main-content {
            padding: 30px;
        }

        .admin-kart {
            background-color: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 20px;
        }

        .table {
            color: #fff;
        }

            .table thead th {
                border-bottom: 2px solid #2a2a2a;
                color: #ff6600;
                font-weight: 600;
                border-top: none;
            }

            .table td {
                border-top: 1px solid #2a2a2a;
                vertical-align: middle;
                color: #ccc;
            }

        .btn-turuncu {
            background-color: #ff6600;
            color: white;
            border: none;
            font-weight: 600;
            border-radius: 8px;
        }

            .btn-turuncu:hover {
                background-color: #e65c00;
                color: white;
            }

        .btn-cikis {
            color: #ff4444 !important;
            border: 1px solid #ff4444;
            border-radius: 8px;
            margin: 20px;
            text-align: center;
        }

            .btn-cikis:hover {
                background-color: #ff4444;
                color: white !important;
            }
    </style>


</head>
<body>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block sidebar shadow">
                <div class="sidebar-brand">🍔 ADMIN</div>
                <div class="nav flex-column">
                    <a class="nav-link" href="/Yonetim/Dashboard/Index"><i class="fas fa-home"></i> Dashboard</a>
                    @if (Session["Yetki"] != null && Session["Yetki"].ToString() == "1")
                    {
                        <a class="nav-link" href="/Yonetim/Kategori/Index">
                            <i class="fas fa-list"></i> Kategoriler
                        </a>

                        <a class="nav-link" href="/Yonetim/Urun/Index">
                            <i class="fas fa-hamburger"></i> Ürünler
                        </a>

                        <a class="nav-link" href="/Yonetim/Hakkimizda/Index">
                            <i class="fas fa-info-circle"></i> Hakkımızda Ayarları
                        </a>

                        <a class="nav-link" href="/Yonetim/Iletisim/Index">
                            <i class="fas fa-address-book"></i> İletişim Ayarları
                        </a>
                    }
                    <a class="nav-link" href="/Home/Index" target="_blank"><i class="fas fa-external-link-alt"></i> Siteye Git</a>
                    <a class="nav-link" href="/Yonetim/Siparis/Index"><i class="fas fa-bell"></i> Gelen Siparişler</a>
                    <div style="margin-top: auto;">
                        <a class="nav-link btn-cikis" href="/Yonetim/Login/CikisYap"><i class="fas fa-sign-out-alt"></i> Çıkış Yap</a>
                    </div>
                </div>
            </nav>
            <main role="main" class="col-md-10 ml-sm-auto main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>