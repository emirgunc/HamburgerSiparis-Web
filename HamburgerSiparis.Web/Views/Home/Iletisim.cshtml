@model IEnumerable<HamburgerSiparis.EntityLayer.Iletisim>

@{
    ViewBag.Title = "İletişim";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Burayı da ana vitrin layout'una bağladık!
}

<div class="container" style="margin-top: 100px; margin-bottom: 100px; color: white;">
    <h1 class="text-center" style="color: #ff9800;">Bize Ulaşın</h1>
    <hr style="border-color: #ff9800; margin-bottom: 40px;" />

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card bg-dark border-warning" style="border-radius: 10px;">
                    <div class="card-body text-center">
                        <i class="fas fa-map-marker-alt fa-3x text-warning mb-3"></i>
                        <h5 class="card-title text-light">Adres</h5>
                        <p class="card-text text-white-50">@item.Adres</p>
                        <hr class="border-secondary">
                        <i class="fas fa-phone fa-2x text-warning mb-2"></i>
                        <p class="text-white-50">@item.Telefon</p>
                        <hr class="border-secondary">
                        <i class="fas fa-envelope fa-2x text-warning mb-2"></i>
                        <p class="text-white-50">@item.Email</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>