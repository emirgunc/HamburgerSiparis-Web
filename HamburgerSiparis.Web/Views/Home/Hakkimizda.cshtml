@model HamburgerSiparis.EntityLayer.Hakkimizda

@{
    ViewBag.Title = "Hakkımızda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 100px; margin-bottom: 100px; color: white;">
    @if (Model != null)
    {
        <h1 class="text-center" style="color: #ff9800;">@Model.Baslik</h1>
        <hr style="border-color: #ff9800;" />
        <p style="font-size: 18px; line-height: 1.8;">@Model.Icerik</p>
    }
</div>